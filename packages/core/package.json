{
  "name": "@acheron-grid/core",
  "version": "0.1.0",
  "type": "module",
  "description": "Headless TypeScript data grid engine",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js"
    }
  },
  "scripts": {
    "build": "node scripts/clean-browser-output.mjs && tsc -p tsconfig.headless.json && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.headless.json",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haodn-dev/acheron-grid.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/haodn-dev/acheron-grid/issues"
  },
  "homepage": "https://acheron-grid.haoduong.dev/",
  "author": "Hao Duong",
  "publishConfig": {
    "access": "public"
  }
}
