{
  "name": "@acheron-grid/export",
  "version": "0.1.0",
  "type": "module",
  "description": "Optional headless CSV selection export for Acheron Grid",
  "license": "Apache-2.0",
  "author": "Hao Duong",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "LICENSE.fflate",
    "NOTICE"
  ],
  "exports": {
    "./html": {
      "types": "./dist/html.d.ts",
      "import": "./dist/html.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@acheron-grid/core": "0.1.0",
    "fflate": "0.8.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://acheron-grid.haoduong.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haodn-dev/acheron-grid.git",
    "directory": "packages/export"
  }
}
